# === App ===
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
LATENCY_WARN_MS=1000
API_HOST=0.0.0.0
API_PORT=8000
MODEL_VERSION=0.1.0

# === Modelo / inferência ===
# USE_ONNX=false -> serve o pipeline sklearn (models/classifier.joblib).
# USE_ONNX=true  -> serve o runtime ONNX (models/classifier.onnx), mais rápido em CPU.
#   Requer ter rodado `make onnx-export` antes.
USE_ONNX=false
MODEL_PATH=models/classifier.joblib
ONNX_MODEL_PATH=models/classifier.onnx
ONNX_LABELS_PATH=models/classifier_labels.json

# === Treino ===
RANDOM_SEED=42
TEST_SIZE=0.2
DATASET_PATH=data/raw/laudos.csv
TEXT_COLUMN=texto
LABEL_COLUMN=especialidade
TFIDF_MAX_FEATURES=5000
RF_N_ESTIMATORS=200
